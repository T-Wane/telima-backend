# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
LOG_LEVEL=info
SWAGGER_ENABLED=true

# Base de donnees (Postgres + PostGIS)
DATABASE_URL=postgresql://telima_user:telima_password@localhost:5432/telima_dev?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change_me_dev_access_secret_min_32_chars_______
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_dev_refresh_secret_min_32_chars______
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_LENGTH=4
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_LOCK_MINUTES=30
OTP_RESEND_COOLDOWN_SECONDS=60
# Si true, la reponse de POST /auth/request-otp inclut le code OTP genere.
# Ne JAMAIS activer en preprod/production. Utile uniquement en dev pour tests curl/Postman
# sans avoir a lire les logs serveur (MockSmsProvider journalise deja le code dans les logs).
OTP_EXPOSE_IN_RESPONSE=true

# SMS Provider (sendtext.sn) - ADR-012
# sendtext : envoi reel via l'API sendtext.sn, necessite les 3 variables ci-dessous.
# mock : aucun appel reseau, code OTP journalise dans les logs (dev/test uniquement).
SMS_PROVIDER=sendtext
SENDTEXT_API_URL=https://api.sendtext.sn/v1/sms/ml
SENDTEXT_API_KEY=
SENDTEXT_API_SECRET=
SENDTEXT_SENDER_NAME=JulakAI

# Stockage fichiers (documents chauffeur) - PAS ENCORE CONFIGURE
# Tant que ces variables sont absentes, StorageModule utilise LocalDiskStorageProvider (voir src/modules/storage).
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=eu-west-1

# Payment Provider (Orange Money) - A PREVOIR SPRINT 4
# Tant que PAYMENT_PROVIDER=mock, PaymentProviderModule utilise MockPaymentProvider.
PAYMENT_PROVIDER=mock
OM_API_KEY=
OM_MERCHANT_KEY=
OM_WEBHOOK_SECRET=
OM_WEBHOOK_URL=
OM_CURRENCY=XOF

# Distance Provider (Google Maps) - A PREVOIR SPRINT 2
# Tant que DISTANCE_PROVIDER=mock, DistanceProviderModule utilise MockDistanceProvider (Haversine).
DISTANCE_PROVIDER=mock
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_CACHE_TTL=3600

# Push Provider (Firebase FCM) - A PREVOIR SPRINT 3
# Tant que PUSH_PROVIDER=mock, PushProviderModule utilise MockPushProvider.
PUSH_PROVIDER=mock
FCM_SERVICE_ACCOUNT_PATH=
FCM_PROJECT_ID=

# Observabilité (Sprint 3+ — roadmap, non actif tant que vide)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
METRICS_ENABLED=false
METRICS_PATH=/metrics
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=telima-backend
OTEL_RESOURCE_ATTRIBUTES=environment=dev
