# Modele de /opt/vtc/.env.prod (chmod 600, JAMAIS dans Git). Les valeurs viennent de l'ancien .env
# du serveur expire (si recuperable) ; sinon a regenerer / redemander.
# Compose lit ce fichier pour la base (POSTGRES_*) ET pour l'API : garder les deux blocs coherents.

# --- Base (service "db") ---
POSTGRES_DB=telima_prod
POSTGRES_USER=telima_user
POSTGRES_PASSWORD=CHANGER_MOT_DE_PASSE_LONG

# --- API ---
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://telima_user:CHANGER_MOT_DE_PASSE_LONG@db:5432/telima_prod?schema=public
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

APP_URL=https://api.telimamobility.com
CORS_ORIGINS=https://dashboard.telimamobility.com
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
SWAGGER_ENABLED=false
LOG_LEVEL=info

# A recuperer de l'ancien .env (ou a regenerer) :
# JWT_ACCESS_SECRET, JWT_REFRESH_SECRET (les regenerer deconnecte tout le monde)
# GOOGLE_MAPS_API_KEY, DISTANCE_PROVIDER=google
# SMS_PROVIDER / OTP_PROVIDER, JULAKAI_* ou SENDTEXT_*  (voir avec Tidiane pour le service OTP)
# OM_* (Orange Money), FCM_PROJECT_ID + FCM_SERVICE_ACCOUNT_PATH (fichier JSON de compte de service)
# SENTRY_DSN (optionnel)
